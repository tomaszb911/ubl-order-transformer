{
  "name": "ubl-order-transformer",
  "version": "1.0.0",
  "description": "Event-driven Cloud Run service that transforms Base64-encoded UBL 2.1 Order XML (Pub/Sub push) into a JSON order and publishes it to an output topic.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:coverage": "vitest run --coverage",
    "pubsub:setup": "tsx scripts/pubsub-setup.ts",
    "pubsub:publish": "tsx scripts/publish-message.ts",
    "pubsub:pull": "tsx scripts/pull-messages.ts",
    "make:message": "tsx scripts/make-message.ts",
    "samples:generate": "tsx scripts/generate-samples.ts",
    "test:emulator": "vitest run test/integration/pubsub-emulator.test.ts"
  },
  "dependencies": {
    "@google-cloud/pubsub": "^6.3.1",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.7",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
